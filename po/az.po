#. Translators: This sentence is later suffixed with an application name. Example: “Quit Tuba?”
#: data/ui/quit-process-dialog.ui:6
msgid "Quit %s?"
msgstr "%s tətbiqindən çıxılsın?"

#: data/ui/quit-process-dialog.ui:7
msgid ""
"Stopping applications might come with side effects, such as data loss of unsaved work."
msgstr ""
"Tətbiqlərin dayandırılması məlumat itkisi və ya yadda saxlanılmamış iş kimi yan "
"təsirlərlə nəticələnə bilər."

