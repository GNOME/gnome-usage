msgstr "Menu principal"

#: data/ui/window.ui:99
msgid "Search"
msgstr "Recherche"

#: data/ui/window.ui:118
msgid "Search Applications…"
msgstr "Recherche d’applications…"

#: data/ui/window.ui:152
msgid "_About Usage"
msgstr "À _propos de Utilisation"

#: data/ui/window.ui:158
msgid "Group system processes"
msgstr "Grouper les processus du système"

#: data/ui/window.ui:164
msgid "Show all processes"
msgstr "Montrer tous les processus"

